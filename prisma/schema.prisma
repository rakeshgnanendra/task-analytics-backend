generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TaskFile {
  id            String            @id @default(uuid())
  fileName      String
  fileUrl       String
  fileSize      Int
  taskId        String
  uploadedById  String
  downloadCount Int               @default(0)
  createdAt     DateTime          @default(now())
  downloads     FileDownloadLog[]
  task          Task              @relation(fields: [taskId], references: [id])
  uploadedBy    User              @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
}

model FileDownloadLog {
  id           String   @id @default(uuid())
  fileId       String
  userId       String
  downloadedAt DateTime @default(now())
  file         TaskFile @relation(fields: [fileId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@index([fileId])
  @@index([userId])
}

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  password             String
  firstName            String
  lastName             String
  username             String            @unique
  role                 GlobalRole        @default(EMPLOYEE)
  isActive             Boolean           @default(true)
  departmentId         String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  activityLogs         ActivityLog[]
  downloads            FileDownloadLog[]
  deliveryHeadProjects Project[]         @relation("DeliveryHeadProjects")
  projectLinks         ProjectMember[]
  assignedTasks        Task[]            @relation("AssignedTasks")
  createdTasks         Task[]            @relation("CreatedTasks")
  uploadedFiles        TaskFile[]
  department           Department        @relation(fields: [departmentId], references: [id])
comments TaskComment[]
  @@index([departmentId])
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  tasks     Task[]
  users     User[]
}

model Project {
  id             String          @id @default(uuid())
  name           String
  description    String?
  status         ProjectStatus   @default(ACTIVE)
  deliveryHeadId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deliveryHead   User?           @relation("DeliveryHeadProjects", fields: [deliveryHeadId], references: [id])
  members        ProjectMember[]
  tasks          Task[]
}

model ProjectMember {
  id        String      @id @default(uuid())
  userId    String
  projectId String
  role      ProjectRole
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([userId, projectId])
  @@index([projectId])
}
model TaskComment {
  id        String   @id @default(uuid())
  message   String
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}
model Task {
  id           String      @id @default(uuid())
  title        String
  description  String?
  dueDate      DateTime
  priority     Priority    @default(MEDIUM)
  status       TaskStatus  @default(CREATED)
  startedAt    DateTime?
  completedAt  DateTime?
  confirmedAt  DateTime?
  isLocked     Boolean     @default(false)
  projectId    String?
  departmentId String?
  assignedToId String
  createdById  String
  isDeleted    Boolean     @default(false)
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  assignedTo   User        @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdBy    User        @relation("CreatedTasks", fields: [createdById], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])
  project      Project?    @relation(fields: [projectId], references: [id])
  files        TaskFile[]
comments TaskComment[]
  @@index([projectId])
  @@index([departmentId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
}

model ActivityLog {
  id          String   @id @default(uuid())
  action      String
  entityType  String
  entityId    String
  performedBy String
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [performedBy], references: [id])

  @@index([entityType])
  @@index([entityId])
  @@index([performedBy])
}

enum GlobalRole {
  SUPER_ADMIN
  DELIVERY_HEAD
  USER
  EMPLOYEE
}

enum ProjectRole {
  PROJECT_MANAGER
  TEAM_MEMBER
}

enum TaskStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
  REWORK
  CONFIRMED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
}
