generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TaskFile {
  id            String            @id @default(uuid())
  fileName      String
  fileUrl       String
  fileSize      Int
  taskId        String
  uploadedById  String
  downloadCount Int               @default(0)
  createdAt     DateTime          @default(now())
  downloads     FileDownloadLog[]
  task          Task              @relation(fields: [taskId], references: [id])
  uploadedBy    User              @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
}

model FileDownloadLog {
  id           String   @id @default(uuid())
  fileId       String
  userId       String
  downloadedAt DateTime @default(now())
  file         TaskFile @relation(fields: [fileId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@index([fileId])
  @@index([userId])
}

model User {
  id                    String            @id @default(uuid())
  email                 String            @unique
  password              String
  firstName             String
  lastName              String
  username              String            @unique
  role                  GlobalRole        @default(EMPLOYEE)
  designation           String?
  isActive              Boolean           @default(true)
  isDepartmentLead      Boolean           @default(false)
  departmentLeadId      String?
  departmentId          String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  mustChangePassword    Boolean           @default(true)
  activityLogs          ActivityLog[]
  downloads             FileDownloadLog[]
  deliveryHeadProjects  Project[]         @relation("DeliveryHeadProjects")
  projectLinks          ProjectMember[]
  assignedTasks         Task[]            @relation("AssignedTasks")
  createdTasks          Task[]            @relation("CreatedTasks")
  uploadedFiles         TaskFile[]
  department            Department        @relation(fields: [departmentId], references: [id])
  departmentLead        User?             @relation("DepartmentLeadMembers", fields: [departmentLeadId], references: [id])
  departmentTeamMembers User[]            @relation("DepartmentLeadMembers")
  comments              TaskComment[]
  chatSeen              TaskChatSeen[]
  notification          Notification[]
  createdKpiTemplates   KpiTemplate[]     @relation("KpiTemplateCreator")
  kpiAssignments        KpiAssignment[]   @relation("KpiAssignmentEmployee")
  managedKpiAssignments KpiAssignment[]   @relation("KpiAssignmentManager")
  kpiFeedbacks          KpiFeedback[]     @relation("KpiFeedbackReviewer")

  @@index([departmentId])
  @@index([departmentLeadId])
  @@index([isDepartmentLead])
}

model Department {
  id           String        @id @default(uuid())
  name         String        @unique
  createdAt    DateTime      @default(now())
  tasks        Task[]
  users        User[]
  kpiTemplates KpiTemplate[]
}

model Project {
  id             String          @id @default(uuid())
  name           String
  description    String?
  status         ProjectStatus   @default(ACTIVE)
  deliveryHeadId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deliveryHead   User?           @relation("DeliveryHeadProjects", fields: [deliveryHeadId], references: [id])
  members        ProjectMember[]
  tasks          Task[]
}

model ProjectMember {
  id        String      @id @default(uuid())
  userId    String
  projectId String
  role      ProjectRole
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([userId, projectId])
  @@index([projectId])
}

model TaskComment {
  id        String   @id @default(uuid())
  message   String
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task        Task     @relation(fields: [taskId], references: [id])
  deliveredTo String[] @default([])
  seenBy      String[] @default([])

  user User @relation(fields: [userId], references: [id])
}

model TaskChatSeen {
  id       String   @id @default(uuid())
  userId   String
  taskId   String
  lastSeen DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  task Task @relation(fields: [taskId], references: [id])

  @@unique([userId, taskId]) // 🔥 important
}

model Task {
  id          String     @id @default(uuid())
  ticketId    String?    @unique
  title       String
  description String?
  dueDate     DateTime
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(CREATED)

  timeSpentMinutes      Int?
  completionComment     String?
  completionAttachments Json?
  isKpiLinked           Boolean            @default(false)
  kpiCategory           String?
  kpiWeight             Float              @default(1)
  kpiAssignmentItemId   String?
  startedAt             DateTime?
  completedAt           DateTime?
  confirmedAt           DateTime?
  isLocked              Boolean            @default(false)
  projectId             String?
  departmentId          String?
  assignedToId          String
  createdById           String
  isDeleted             Boolean            @default(false)
  deletedAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  assignedTo            User               @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdBy             User               @relation("CreatedTasks", fields: [createdById], references: [id])
  department            Department?        @relation(fields: [departmentId], references: [id])
  project               Project?           @relation(fields: [projectId], references: [id])
  files                 TaskFile[]
  comments              TaskComment[]
  chatSeen              TaskChatSeen[]
  kpiAssignmentItem     KpiAssignmentItem? @relation(fields: [kpiAssignmentItemId], references: [id])

  @@index([projectId])
  @@index([departmentId])
  @@index([assignedToId])
  @@index([kpiAssignmentItemId])
  @@index([status])
  @@index([dueDate])
}

model KpiCycle {
  id                 String          @id @default(uuid())
  name               String
  financialYear      String
  startDate          DateTime
  endDate            DateTime
  managerReviewStart DateTime?
  managerReviewEnd   DateTime?
  status             KpiCycleStatus  @default(DRAFT)
  releaseToEmployees Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  assignments        KpiAssignment[]

  @@unique([financialYear])
  @@index([status])
}

model KpiTemplate {
  id           String            @id @default(uuid())
  name         String
  role         GlobalRole?
  designation  String?
  departmentId String?
  createdById  String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  department   Department?       @relation(fields: [departmentId], references: [id])
  createdBy    User?             @relation("KpiTemplateCreator", fields: [createdById], references: [id])
  items        KpiTemplateItem[]
  assignments  KpiAssignment[]

  @@index([role])
  @@index([designation])
  @@index([departmentId])
}

model KpiTemplateItem {
  id              String              @id @default(uuid())
  templateId      String
  category        String
  goal            String
  measure         String?
  weight          Float
  taskLinked      Boolean             @default(true)
  sortOrder       Int                 @default(0)
  template        KpiTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  assignmentItems KpiAssignmentItem[]

  @@index([templateId])
}

model KpiAssignment {
  id                   String              @id @default(uuid())
  cycleId              String
  employeeId           String
  templateId           String?
  managerId            String?
  status               KpiAssignmentStatus @default(DRAFT)
  autoScore            Float               @default(0)
  managerAdjustment    Float               @default(0)
  finalScore           Float               @default(0)
  managerFinalComments String?
  employeeComments     String?
  employeeAcknowledgedAt DateTime?
  employeeAcknowledgementComment String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  cycle                KpiCycle            @relation(fields: [cycleId], references: [id])
  employee             User                @relation("KpiAssignmentEmployee", fields: [employeeId], references: [id])
  template             KpiTemplate?        @relation(fields: [templateId], references: [id])
  manager              User?               @relation("KpiAssignmentManager", fields: [managerId], references: [id])
  items                KpiAssignmentItem[]
  feedbacks            KpiFeedback[]

  @@unique([cycleId, employeeId])
  @@index([employeeId])
  @@index([managerId])
  @@index([status])
}

model KpiAssignmentItem {
  id                String           @id @default(uuid())
  assignmentId      String
  templateItemId    String?
  category          String
  goal              String
  measure           String?
  weight            Float
  taskLinked        Boolean          @default(true)
  completionScore   Float            @default(0)
  onTimeScore       Float            @default(0)
  qualityScore      Float            @default(0)
  productivityScore Float            @default(0)
  currentScore      Float            @default(0)
  managerScore      Float?
  managerComments   String?
  assignment        KpiAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  templateItem      KpiTemplateItem? @relation(fields: [templateItemId], references: [id])
  tasks             Task[]

  @@index([assignmentId])
  @@index([templateItemId])
  @@index([category])
}

model KpiFeedback {
  id           String         @id @default(uuid())
  assignmentId String
  reviewerId   String
  phase        KpiReviewPhase
  rating       String?
  comment      String
  adjustment   Float          @default(0)
  createdAt    DateTime       @default(now())
  assignment   KpiAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reviewer     User           @relation("KpiFeedbackReviewer", fields: [reviewerId], references: [id])

  @@index([assignmentId])
  @@index([reviewerId])
  @@index([phase])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String // CHAT | MENTION | ASSIGNED | STATUS
  message     String
  taskId      String?
  referenceId String?
  isRead      Boolean  @default(false)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id          String   @id @default(uuid())
  action      String
  entityType  String
  entityId    String
  performedBy String
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [performedBy], references: [id])

  @@index([entityType])
  @@index([entityId])
  @@index([performedBy])
}

enum GlobalRole {
  SUPER_ADMIN
  DELIVERY_HEAD
  HR
  USER
  EMPLOYEE
}

enum KpiCycleStatus {
  DRAFT
  ACTIVE
  REVIEW_OPEN
  CLOSED
}

enum KpiAssignmentStatus {
  DRAFT
  ASSIGNED
  REVIEW_OPEN
  REVIEWED
  ACKNOWLEDGED
  FINALIZED
}

enum KpiReviewPhase {
  PLANNING
  MID_YEAR
  FINAL
}

enum ProjectRole {
  PROJECT_MANAGER
  TEAM_MEMBER
}

enum TaskStatus {
  PENDING_APPROVAL
  CREATED
  IN_PROGRESS
  COMPLETED
  REWORK
  CONFIRMED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
}
